<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Game Lăn Bóng Siêu Đơn Giản</title><style>body{background-color:#0f172a;color:#fff;font-family:sans-serif;margin:0;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;overflow:hidden}#scoreBoard{font-size:20px;font-weight:bold;margin-bottom:10px;color:#38bdf8}#gameCanvas{background-color:#1e293b;border:4px solid #334155;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.5)}#msg{margin-top:10px;font-size:14px;color:#9ca3af}</style></head><body><div id="scoreBoard">Điểm số: <span id="score">0</span></div><canvas id="gameCanvas" width="400" height="400"></canvas><div id="msg">Dùng các phím Mũi Tên (Up, Down, Left, Right) để điều khiển bóng lăn!</div><script>const canvas=document.getElementById("gameCanvas"),ctx=canvas.getContext("2d"),scoreDisplay=document.getElementById("score");let score=0,gameOver=!1;const ball={x:200,y:200,radius:15,speed:4},point={x:Math.random()*360+20,y:Math.random()*360+20,radius:8},enemy={x:Math.random()*360+20,y:Math.random()*360+20,radius:12,dx:2,dy:2};const keys={};window.addEventListener("keydown",e=>{keys[e.code]=!0}),window.addEventListener("keyup",e=>{keys[e.code]=!1});function update(){if(gameOver)return;if((keys.ArrowUp||keys.KeyW)&&ball.y-ball.radius>0&&(ball.y-=ball.speed),(keys.ArrowDown||keys.KeyS)&&ball.y+ball.radius<canvas.height&&(ball.y+=ball.speed),(keys.ArrowLeft||keys.KeyA)&&ball.x-ball.radius>0&&(ball.x-=ball.speed),(keys.ArrowRight||keys.KeyD)&&ball.x+ball.radius<canvas.width&&(ball.x+=ball.speed),enemy.x+=enemy.dx,enemy.y+=enemy.dy,(enemy.x-enemy.radius<0||enemy.x+enemy.radius<canvas.width)&&(enemy.dx=-enemy.dx),(enemy.y-enemy.radius<0||enemy.y+enemy.radius>canvas.height)&&(enemy.dy=-enemy.dy),Math.hypot(ball.x-point.x,ball.y-point.y)<ball.radius+point.radius&&(score++,scoreDisplay.innerText=score,point.x=Math.random()*360+20,point.y=Math.random()*360+20,ball.speed+=0.2,enemy.dx*=1.05,enemy.dy*=1.1),Math.hypot(ball.x-enemy.x,ball.y-enemy.y)<ball.radius+enemy.radius)return gameOver=!0,alert("Game Over! Quả bóng bị nổ rồi. Tổng điểm của bạn: "+score),void location.reload()}function draw(){ctx.clearRect(0,0,canvas.width,canvas.height),ctx.beginPath(),ctx.arc(point.x,point.y,point.radius,0,2*Math.PI),ctx.fillStyle="#f59e0b",ctx.fill(),ctx.closePath(),ctx.beginPath(),ctx.arc(enemy.x,enemy.y,enemy.radius,0,2*Math.PI),ctx.fillStyle="#ef4444",ctx.fill(),ctx.closePath(),ctx.beginPath(),ctx.arc(ball.x,ball.y,ball.radius,0,2*Math.PI),ctx.fillStyle="#10b981",ctx.fill(),ctx.shadowColor="#10b981",ctx.shadowBlur=10,ctx.closePath(),ctx.shadowBlur=0}function gameLoop(){update(),draw(),requestAnimationFrame(gameLoop)}gameLoop();</script></body></html>
